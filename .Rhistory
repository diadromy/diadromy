retrieve_IUCN_data <- function(speciesList, api_key = Sys.getenv("IUCN_REDLIST_KEY")){
IUCN_status <- data.frame(Species = character(), Status = character(),
Trend = character(), stringsAsFactors = FALSE)
for(sp in speciesList){
parts <- strsplit(sp, " ")[[1]]
result <- tryCatch(
rl_species(genus = parts[1], species = parts[2], key = api_key),
error = function(e) NULL
)
if (is.null(result) || length(result$assessments) == 0){
IUCN_status_sp <- data.frame(Species = sp, Status = "NA", Trend = "NA",
stringsAsFactors = FALSE)
cat(sp, "----- CHECK\n")
} else {
latest <- result$assessments[result$assessments$latest == TRUE, ]
IUCN_status_sp <- data.frame(Species = sp,
Status = latest$red_list_category_code,
Trend = latest$population_trend,
stringsAsFactors = FALSE)
}
IUCN_status <- rbind(IUCN_status, IUCN_status_sp)
Sys.sleep(0.5)
}
return(IUCN_status)
}
