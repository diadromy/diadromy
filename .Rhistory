geom_point(color = 'gray50') +
geom_point(    data = Nepal[!is.na(Nepal$dam_name) & Nepal$dam_name %in% hss_names, ],
aes(color = dam_name)) +
scale_color_manual(
values = c('Mai Beni' = 'blue',
'Chuwa Khola' = 'red',
'Kabeli-A'= 'orange',
'Upper Chuwa Lurupya Khola' = '#2ca02c')
) +
scale_size_binned(
range = c(1, 5),
name = 'Dam installed capacity (MW)',
limits = c(0, max(Nepal$capacity_mw)),  # covers all dams
breaks = c(50, 300, 600, 900)
#labels = c('≤ 100', '≤ 400', '≤ 700', '≤ 900')
# set breaks that span your data range
) +  scale_x_continuous(expand = c(0, 0), limits = c(0, 1.02)) +
labs(color = 'HSS Dams',
x = 'Inclusion probability',
y = 'Percent of cumulative portfolio capacity',
title = 'Nepal') +
theme_bw()
IC_IP
